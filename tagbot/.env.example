# Copy to tagbot/.env for local review runs. Never commit real secrets.

# Public fleet JSON (same data as https://mynode.uk/api/v3/nodes)
ALERTER_API_URL=https://mynode.uk/api/v3/nodes
ALERTER_DASH_URL=https://mynode.uk

# Optional: used only to discover the alerts channel for chat cleanup
# ALERTER_DISCORD_WEBHOOK_URL=

ALERTER_TAGS_FILE=./data/tags.json
ALERTER_TAG_MAX_HOSTS=5

# Discord Developer Portal → Application → Bot token + Application ID
ALERTER_DISCORD_BOT_TOKEN=
ALERTER_DISCORD_CLIENT_ID=
# Optional: guild id for instant slash-command registration
# ALERTER_DISCORD_GUILD_ID=

# Channel id(s) where plain chat is deleted (comma-separated). Empty = webhook channel.
# ALERTER_TAGBOT_MOD_CHANNEL_ID=
